* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --bg: #09090b;
  --bg-panel: rgba(18, 18, 22, 0.9);
  --bg-card: #111113;
  --bg-soft: #1c1d21;
  --border: rgba(255, 255, 255, 0.08);
  --border-strong: rgba(239, 68, 68, 0.4);
  --text: #f5f5f5;
  --muted: #b0b3be;
  --accent: #e11d2e;
  --accent-strong: #b2071a;
  --accent-soft: rgba(225, 29, 46, 0.12);
  --success: #34d399;
  --shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
}

html {
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(225, 29, 46, 0.2), transparent 36%),
    radial-gradient(circle at bottom right, rgba(225, 29, 46, 0.14), transparent 28%),
    var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.page-shell {
  position: relative;
  max-width: 1240px;
  margin: 0 auto;
  padding: 32px 24px 72px;
}

.background-glow {
  position: absolute;
  width: 420px;
  height: 420px;
  border-radius: 9999px;
  filter: blur(90px);
  opacity: 0.28;
  pointer-events: none;
}

.glow-left {
  top: 0;
  left: -120px;
  background: rgba(225, 29, 46, 0.8);
}

.glow-right {
  right: -120px;
  bottom: 60px;
  background: rgba(163, 20, 39, 0.7);
}

.topbar,
.hero-grid,
.dashboard-panel,
.subjects-panel,
.tutor-panel {
  position: relative;
  z-index: 1;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 20px 22px;
  background: rgba(12, 12, 15, 0.8);
  border: 1px solid var(--border);
  border-radius: 18px;
  backdrop-filter: blur(16px);
  box-shadow: var(--shadow);
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--accent), #8d0f1d);
  font-weight: 700;
  color: white;
  box-shadow: 0 12px 28px rgba(225, 29, 46, 0.5);
}

.brand-name {
  font-size: 1.1rem;
  font-weight: 700;
}

.brand-tag {
  color: var(--muted);
  font-size: 0.74rem;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 22px;
  color: var(--muted);
}

.nav-links a {
  transition: color 0.2s ease;
}

.nav-links a:hover {
  color: var(--text);
}

.primary-btn,
.secondary-btn {
  border: none;
  border-radius: 12px;
  font-weight: 700;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.primary-btn {
  background: linear-gradient(135deg, var(--accent), var(--accent-strong));
  color: white;
  padding: 0.9rem 1.4rem;
  box-shadow: 0 16px 25px rgba(225, 29, 46, 0.35);
}

.primary-btn:hover,
.secondary-btn:hover {
  transform: translateY(-1px);
}

.primary-btn:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.secondary-btn {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 0.9rem 1.4rem;
}

.small-btn {
  padding: 0.7rem 1.1rem;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 24px;
  align-items: center;
  padding-top: 32px;
}

.eyebrow,
.muted-label {
  display: inline-flex;
  align-items: center;
  border: 1px solid var(--border-strong);
  background: var(--accent-soft);
  color: #ffb0b9;
  padding: 0.45rem 0.8rem;
  border-radius: 9999px;
  font-size: 0.78rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.hero-copy h1 {
  margin-top: 18px;
  font-size: clamp(2.8rem, 5vw, 5rem);
  line-height: 0.98;
  letter-spacing: -0.05em;
}

.hero-copy p {
  max-width: 620px;
  margin-top: 18px;
  color: var(--muted);
  font-size: 1.08rem;
}

.cta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 28px;
}

.mini-metrics {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 18px;
  margin-top: 30px;
}

.mini-metrics div {
  display: flex;
  flex-direction: column;
  min-width: 120px;
}

.mini-metrics strong {
  font-size: 1.7rem;
}

.mini-metrics span {
  color: var(--muted);
}

.hero-card,
.dashboard-panel,
.subjects-panel,
.tutor-panel {
  background: rgba(14, 14, 16, 0.85);
  border: 1px solid var(--border);
  border-radius: 24px;
  box-shadow: var(--shadow);
}

.hero-card {
  padding: 24px;
}

.card-header,
.row-between,
.panel-heading,
.form-actions,
.subject-topline,
.progress-meta,
.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.card-header {
  color: var(--muted);
  font-size: 0.9rem;
}

.status-pill,
.badge {
  background: rgba(52, 211, 153, 0.12);
  color: var(--success);
  border: 1px solid rgba(52, 211, 153, 0.4);
  padding: 0.35rem 0.7rem;
  border-radius: 9999px;
  font-size: 0.72rem;
}

.hero-card h3 {
  margin-top: 18px;
  font-size: 1.8rem;
}

.focus-list {
  list-style: none;
  margin-top: 16px;
  display: grid;
  gap: 10px;
  color: var(--muted);
}

.focus-list li::before {
  content: '•';
  color: var(--accent);
  margin-right: 10px;
}

.progress-block {
  margin-top: 18px;
}

.progress-rail {
  position: relative;
  width: 100%;
  height: 12px;
  margin-top: 10px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--border);
  border-radius: 9999px;
  overflow: hidden;
}

.progress-rail.small {
  height: 10px;
}

.progress-bar {
  position: absolute;
  inset: 0 auto 0 0;
  width: 68%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--accent), #ff6b6b);
}

.dashboard-panel,
.subjects-panel,
.tutor-panel {
  margin-top: 28px;
  padding: 28px 24px;
}

.panel-heading {
  margin-bottom: 24px;
}

.panel-heading h2 {
  margin-top: 8px;
  font-size: clamp(1.7rem, 2vw, 2.3rem);
}

.panel-heading a {
  color: #ffb0b9;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.stat-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 22px 18px;
}

.stat-card span {
  color: var(--muted);
  display: block;
  font-size: 0.86rem;
}

.stat-card strong {
  display: block;
  margin-top: 16px;
  font-size: clamp(1.5rem, 2vw, 2.1rem);
}

.subjects-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.subject-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 18px 16px;
}

.subject-card h3 {
  font-size: 1.2rem;
}

.subject-topline span {
  color: #ffb0b9;
  font-size: 0.72rem;
}

.progress-meta {
  margin-top: 20px;
  color: var(--muted);
  font-size: 0.85rem;
}

.progress-meta strong {
  color: var(--text);
}

.tutor-layout {
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr);
  gap: 18px;
}

.question-rail,
.chat-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border);
  border-radius: 20px;
}

.question-rail {
  padding: 18px 14px;
}

.rail-label {
  color: var(--muted);
  margin-bottom: 14px;
}

.quick-list {
  display: grid;
  gap: 10px;
}

.quick-question {
  width: 100%;
  text-align: left;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 0.85rem 0.8rem;
  color: var(--text);
}

.quick-question:hover {
  border-color: var(--border-strong);
}

.chat-card {
  padding: 18px;
}

.chat-header {
  justify-content: flex-start;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border);
  color: var(--muted);
}

.online-dot {
  width: 10px;
  height: 10px;
  border-radius: 9999px;
  background: var(--success);
  box-shadow: 0 0 0 6px rgba(52, 211, 153, 0.08);
}

.chat-window {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 18px 0;
  min-height: 260px;
}

.message-row {
  display: flex;
}

.message-row.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 86%;
  padding: 0.9rem 1rem;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border);
  color: var(--text);
  white-space: pre-wrap;
}

.message-row.user .bubble {
  background: linear-gradient(135deg, rgba(225, 29, 46, 0.2), rgba(225, 29, 46, 0.08));
  border-color: rgba(225, 29, 46, 0.45);
}

.typing {
  display: flex;
  gap: 6px;
}

.typing span {
  width: 8px;
  height: 8px;
  border-radius: 9999px;
  background: rgba(255, 255, 255, 0.7);
  animation: pulse 1.2s ease-in-out infinite;
}

.typing span:nth-child(2) {
  animation-delay: 0.15s;
}

.typing span:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 0.4;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(-2px);
  }
}

.chat-form {
  display: grid;
  gap: 14px;
}

.chat-form textarea {
  width: 100%;
  resize: vertical;
  min-height: 110px;
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 1rem 1.1rem;
  background: rgba(10, 10, 12, 0.9);
  color: var(--text);
  outline: none;
}

.chat-form textarea:focus {
  border-color: rgba(225, 29, 46, 0.7);
  box-shadow: 0 0 0 3px rgba(225, 29, 46, 0.12);
}

.hint {
  color: var(--muted);
  font-size: 0.78rem;
}

.error-message {
  margin-top: 12px;
  color: #ff8f9a;
}

.success-message {
  margin-top: 12px;
  color: var(--success);
}

@media (max-width: 980px) {
  .hero-grid,
  .tutor-layout,
  .subjects-grid,
  .stats-grid {
    grid-template-columns: 1fr 1fr;
  }

  .hero-grid {
    grid-template-columns: 1fr;
  }

  .tutor-layout {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 700px) {
  .page-shell {
    padding: 18px 14px 48px;
  }

  .topbar {
    flex-wrap: wrap;
  }

  .nav-links {
    order: 3;
    width: 100%;
    justify-content: space-between;
  }

  .stats-grid,
  .subjects-grid {
    grid-template-columns: 1fr;
  }

  .panel-heading,
  .form-actions,
  .card-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .primary-btn,
  .secondary-btn {
    width: 100%;
  }
}
